{
    "name": "dreamfactory/df-ai",
    "description": "AI Connection service type for DreamFactory - connect to AI/LLM providers",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["dreamfactory", "ai", "llm", "anthropic", "openai", "ollama"],
    "require": {
        "php": "^8.3",
        "dreamfactory/df-core": "~1.0",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/support": "^11.0",
        "illuminate/database": "^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "DreamFactory\\Core\\AI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DreamFactory\\Core\\AI\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DreamFactory\\Core\\AI\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
